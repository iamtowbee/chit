{
  "name": "continue-protocol",
  "version": "1.0.0",
  "description": "Continue/Resume API - a small state machine + persistence layer for resumable work",
  "type": "module",
  "main": "dist/platform.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/platform.js",
    "platform": "tsx src/platform.ts",
    "downloadbox": "tsx src/downloadbox.ts",
    "ollyba": "tsx src/ollyba/bot.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
